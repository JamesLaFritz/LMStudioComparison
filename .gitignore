# Installed dependencies — every run installs its own from the committed
# lockfile. 172 MB of the project's 173 MB lives here; the lockfile is the
# reproducible artifact, node_modules is just its output.
node_modules/

# Build output. `dist/` existing is evidence a build succeeded, but that fact
# belongs in RUN.md, not in 30 transformed modules.
dist/
.vite/

# Generated games are results and ARE tracked — a scored run has to be
# inspectable later. Nothing under Results/<model>/src, games/, or *.js is
# ignored on purpose.

# Playwright / gate run artefacts. The reports under
# wayfinder/.../playability-gate/evidence/ are the kept record; these are scratch.
test-results/
playwright-report/

# Playwright MCP / playwright-cli session scratch. The models themselves write
# .playwright-cli/ into their workspaces when they verify -- a 9.9 MB console
# log in one case. audit.json records that they did it; the logs are noise.
.playwright-mcp/
.playwright-cli/

# Raw Codex rollouts of the quarantined Sol run: 143 MB of a run that is not a reference.
# Its derived session.json / run.json / RUN.md / CONTAMINATED.md are committed.
Results/_frontier-2026-09-15/*/run1.contaminated-codex-memory/rollouts/
tools/__pycache__/
